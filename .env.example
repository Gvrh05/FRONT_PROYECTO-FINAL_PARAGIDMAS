# Configuración pública del navegador, sin secretos ni credenciales.
# Mismo origen: Vite/Nginx reenvían Auth, API, uploads y Socket.IO.
VITE_API_URL=/kahoot-api
VITE_AUTH_API_URL=/auth
# Vacío: usar el origen desde el que se abre la web.
VITE_WS_URL=
# Para QR en red de aula, configurar por ejemplo http://192.168.1.20:5173
# No incluir rutas, credenciales, query ni fragmentos.
VITE_PUBLIC_WEB_URL=
